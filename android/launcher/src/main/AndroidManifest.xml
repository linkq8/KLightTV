<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- hosted wallpapers, the optional card -->
    <!-- ADB-granted for Xiaomi's system-consumed Netflix button; filtered locally, never stored. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- the optional home-screen card reads the screensaver's settings (signature permission, same key) -->
    <uses-permission android:name="kw.urtv.screensaver.READ_CONFIG" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- apps with only an ordinary launcher activity (OEM stores and settings, phone apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- other home screens, left out of the grid -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="kw.urtv.screensaver" />
        <package android:name="com.todtv.tod" />
    </queries>

    <application android:supportsRtl="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/Home">
        <service
            android:name=".RemoteButtonService"
            android:label="@string/remote_button_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_button_service" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- «ترتيب المفضلة»: the favourites as a list; also opened from the screensaver's settings -->
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- favourites row from ADB (agents, optimize/dock.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kw.urtv.home.GET_DOCK" />
                <action android:name="kw.urtv.home.LIST_APPS" />
                <action android:name="kw.urtv.home.SET_DOCK" />
                <action android:name="kw.urtv.home.RESET_DOCK" />
            </intent-filter>
        </receiver>
        <activity android:name="kw.urtv.shared.CalendarActivity" android:exported="true" android:screenOrientation="landscape" />
    <activity android:name=".ManageAppsActivity" android:exported="true" android:screenOrientation="landscape" />
<activity android:name=".PersonalizeActivity" android:exported="true" android:screenOrientation="landscape" />
<provider android:name=".PhotoProvider" android:authorities="kw.urtv.home.photos" android:exported="true" android:readPermission="kw.urtv.screensaver.READ_CONFIG" />
</application>
</manifest>
