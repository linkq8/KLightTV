<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="kw.urtv.screensaver.READ_CONFIG" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- the launcher (same signing key) reads the settings for its home-screen card -->
    <permission
        android:name="kw.urtv.screensaver.READ_CONFIG"
        android:protectionLevel="signature" />

    <!-- opens the launcher's «ترتيب المفضلة» from settings -->
    <queries>
        <package android:name="kw.urtv.home" />
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- opening the app shows its settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- full-screen preview; any remote key closes it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".ScreenDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- settings from ADB (agents, optimize/saver.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".SaverReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kw.urtv.screensaver.GET" />
                <action android:name="kw.urtv.screensaver.SET" />
                <action android:name="kw.urtv.screensaver.CITIES" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ConfigProvider"
            android:authorities="kw.urtv.screensaver.config"
            android:exported="true"
            android:readPermission="kw.urtv.screensaver.READ_CONFIG"
            android:writePermission="kw.urtv.screensaver.READ_CONFIG" />
        <activity android:name="kw.urtv.shared.CalendarActivity" android:exported="true" android:screenOrientation="landscape" />
    <activity android:name="kw.urtv.shared.DisplaySettingsActivity" android:exported="false" android:screenOrientation="landscape" />
<activity android:name="kw.urtv.shared.PerformanceActivity" android:exported="false" android:screenOrientation="landscape" />
<activity android:name=".PrayerAdjustActivity" android:exported="false" android:screenOrientation="landscape" />
</application>
</manifest>
